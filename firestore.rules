rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerfiedOwner() {
      return isSignedIn() &&
        request.auth.token.email == "andreluiz1902@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validator for Project Entity
    function isValidProject(data) {
      return data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.category is string && data.category.size() <= 100 &&
        data.imageUrl is string && data.imageUrl.size() <= 1500 &&
        (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 1000)) &&
        (!data.keys().hasAny(['link']) || (data.link is string && data.link.size() <= 1000)) &&
        (!data.keys().hasAny(['updatedBy']) || (data.updatedBy is string && data.updatedBy.size() <= 256)) &&
        (!data.keys().hasAny(['fromPhotos']) || (data.fromPhotos is bool)) &&
        data.updatedAt == request.time;
    }

    // Rules for projects collection
    match /projects/{projectId} {
      // Anyone can read project configurations to display the portfolio
      allow get, list: if true;

      // Only the verified admin can create, delete, or update
      allow create: if isVerfiedOwner() && 
        isValidId(projectId) && 
        isValidProject(incoming()) && 
        incoming().updatedBy == request.auth.uid;

      allow delete: if isVerfiedOwner();

      allow update: if isVerfiedOwner() && 
        isValidId(projectId) && 
        isValidProject(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().id == existing().id;
    }
  }
}
